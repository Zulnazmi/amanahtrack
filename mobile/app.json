{
  "expo": {
    "name": "AmanahTrack",
    "slug": "amanahtrack",
    "version": "0.1.0",
    "scheme": "amanahtrack",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "AmanahTrack menggunakan mikrofon hanya apabila anda menekan butang cakap.",
          "speechRecognitionPermission": "AmanahTrack menukar suara anda kepada teks soalan.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ]
    ],
    "android": {
      "package": "my.amanahtrack.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06100D"
      },
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "my.amanahtrack.app",
      "supportsTablet": true
    },
    "newArchEnabled": true,
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2be3aaf1-f908-4019-a074-406f24b49a43"
      }
    },
    "owner": "zesuro",
    "icon": "./assets/icon.png",
    "backgroundColor": "#06100D"
  }
}
